<Project>
  <PropertyGroup>
    <BundleFirmware Condition="'$(BundleFirmware)' == ''">true</BundleFirmware>
    <OfficialFirmwarePath Condition="'$(OfficialFirmwarePath)' == ''">$(MSBuildThisFileDirectory)../research/_fw/Lennox_FW_V17.0.37.bin</OfficialFirmwarePath>
    <R2FirmwarePath Condition="'$(R2FirmwarePath)' == ''">$(MSBuildThisFileDirectory)../research/custom_fw/aux_no_amp_sleep_display_25.2.52_r2/Middleton_AUX-no-amp-sleep_no-10min-off_display-25.2.52_EXPERIMENTAL.bin</R2FirmwarePath>
  </PropertyGroup>
  <Target Name="ValidateFirmwareInputs" BeforeTargets="PrepareForBuild" Condition="'$(BundleFirmware)' == 'true'">
    <Error Condition="!Exists('$(OfficialFirmwarePath)') or !Exists('$(R2FirmwarePath)')" Text="Supply OfficialFirmwarePath and R2FirmwarePath for a complete portable release. For source-only CI use BundleFirmware=false; that build does not include firmware." />
    <GetFileHash Files="$(OfficialFirmwarePath)" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="OfficialFirmwareHash" /></GetFileHash>
    <GetFileHash Files="$(R2FirmwarePath)" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="R2FirmwareHash" /></GetFileHash>
    <Error Condition="'%(OfficialFirmwareHash.FileHash)' != 'DB74C3468BD08D61F3A4E4E4E9E6EEA9B19D95D6E852B9FD5E9CBAC3E91C9472'" Text="Official firmware SHA-256 mismatch." />
    <Error Condition="'%(R2FirmwareHash.FileHash)' != '80ED2088247976F10968F5D4AEFB3CABF367FF0B0A1F774AC6E62A292C459024'" Text="R2 firmware SHA-256 mismatch." />
  </Target>
  <ItemGroup Condition="'$(BundleFirmware)' == 'true'">
    <Content Include="$(OfficialFirmwarePath)" Link="Firmware/official.bin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(R2FirmwarePath)" Link="Firmware/r2.bin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(PortableNoticesPath)' != ''">
    <Content Include="$(PortableNoticesPath)/**/*" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ExcludeNativeDebugSymbolsFromPortablePackage" BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup><ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" /></ItemGroup>
  </Target>
</Project>
